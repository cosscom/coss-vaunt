{
  "name": "vaunt",
  "version": "0.1.0",
  "description": "Product videos for web apps, made from the app itself. Run `npx vaunt start`.",
  "type": "module",
  "bin": {
    "vaunt": "./bin/vaunt.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "tsc --pretty --noEmit",
    "prepack": "bun scripts/build.ts"
  },
  "dependencies": {
    "agent-browser": "0.43.0",
    "next": "16.4.6",
    "playwright": "1.64.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.3.13",
    "@types/node": "20.17.23",
    "typescript": "7.0.2"
  }
}
