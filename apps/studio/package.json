{
  "name": "@coss/vaunt",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "dev": "next dev --port 3102",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "start": "next start --port 3102",
    "type-check": "tsc --pretty --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@coss/ui": "workspace:*",
    "@coss/vaunt-engine": "workspace:*",
    "@xyflow/react": "12.11.2",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "20.17.23",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "tailwindcss": "4.1.17",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
