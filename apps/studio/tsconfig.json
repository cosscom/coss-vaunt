{
  "extends": "@calcom/tsconfig/nextjs.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"],
      "@coss/ui/*": ["../../packages/coss-ui/src/*"]
    },
    "plugins": [{ "name": "next" }],
    "module": "preserve"
  },
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
