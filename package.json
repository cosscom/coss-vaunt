{
  "name": "coss-vaunt",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/studio dev",
    "build": "bun run --cwd apps/studio build",
    "start": "bun run --cwd apps/studio start",
    "type-check": "bun run --filter '*' type-check",
    "test": "TZ=UTC bun run --filter '*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "vite": "8.3.5"
  }
}
